{
  "name": "admin",
  "sourceRoot": "apps/mfe/admin/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/rspack:rspack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "apps/mfe/admin/dist",
        "main": "apps/mfe/admin/src/main.ts",
        "tsConfig": "apps/mfe/admin/tsconfig.app.json",
        "rspackConfig": "apps/mfe/admin/rspack.config.ts"
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": false
        }
      }
    },
    "serve": {
      "executor": "@nx/rspack:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "admin:build",
        "port": 4207,
        "hmr": true
      },
      "configurations": {
        "development": {
          "buildTarget": "admin:build:development"
        },
        "production": {
          "buildTarget": "admin:build:production",
          "hmr": false
        }
      }
    }
  },
  "tags": ["scope:admin", "type:app"]
}
